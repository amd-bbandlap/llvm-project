define void @extra_read_of_promoted_location(ptr %a, ptr noalias %x, ptr noalias %y, ptr noalias %out, i64 %k, i64 %n) {
; CHECK-LABEL: define void @extra_read_of_promoted_location(
; CHECK-SAME: ptr [[A:%.*]], ptr noalias [[X:%.*]], ptr noalias [[Y:%.*]], ptr noalias [[OUT:%.*]], i64 [[K:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[PK:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[K]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[XP:%.*]] = getelementptr inbounds i32, ptr [[X]], i64 [[I]]
; CHECK-NEXT:    [[XV:%.*]] = load i32, ptr [[XP]], align 4
; CHECK-NEXT:    [[KV:%.*]] = load i32, ptr [[PK]], align 4
; CHECK-NEXT:    [[KSUM:%.*]] = add i32 [[KV]], [[XV]]
; CHECK-NEXT:    store i32 [[KSUM]], ptr [[PK]], align 4
; CHECK-NEXT:    [[YP:%.*]] = getelementptr inbounds i32, ptr [[Y]], i64 [[I]]
; CHECK-NEXT:    [[YV:%.*]] = load i32, ptr [[YP]], align 4
; CHECK-NEXT:    [[PI:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; CHECK-NEXT:    [[IV:%.*]] = load i32, ptr [[PI]], align 4
; CHECK-NEXT:    [[ISUM:%.*]] = add i32 [[IV]], [[YV]]
; CHECK-NEXT:    store i32 [[ISUM]], ptr [[PI]], align 4
; CHECK-NEXT:    [[OP:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[I]]
; CHECK-NEXT:    store i32 [[IV]], ptr [[OP]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
; DISABLED-LABEL: define void @extra_read_of_promoted_location(
; DISABLED-SAME: ptr [[A:%.*]], ptr noalias [[X:%.*]], ptr noalias [[Y:%.*]], ptr noalias [[OUT:%.*]], i64 [[K:%.*]], i64 [[N:%.*]]) {
; DISABLED-NEXT:  [[ENTRY:.*]]:
; DISABLED-NEXT:    [[PK:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[K]]
; DISABLED-NEXT:    br label %[[LOOP:.*]]
; DISABLED:       [[LOOP]]:
; DISABLED-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; DISABLED-NEXT:    [[XP:%.*]] = getelementptr inbounds i32, ptr [[X]], i64 [[I]]
; DISABLED-NEXT:    [[XV:%.*]] = load i32, ptr [[XP]], align 4
; DISABLED-NEXT:    [[KV:%.*]] = load i32, ptr [[PK]], align 4
; DISABLED-NEXT:    [[KSUM:%.*]] = add i32 [[KV]], [[XV]]
; DISABLED-NEXT:    store i32 [[KSUM]], ptr [[PK]], align 4
; DISABLED-NEXT:    [[YP:%.*]] = getelementptr inbounds i32, ptr [[Y]], i64 [[I]]
; DISABLED-NEXT:    [[YV:%.*]] = load i32, ptr [[YP]], align 4
; DISABLED-NEXT:    [[PI:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[I]]
; DISABLED-NEXT:    [[IV:%.*]] = load i32, ptr [[PI]], align 4
; DISABLED-NEXT:    [[ISUM:%.*]] = add i32 [[IV]], [[YV]]
; DISABLED-NEXT:    store i32 [[ISUM]], ptr [[PI]], align 4
; DISABLED-NEXT:    [[OP:%.*]] = getelementptr inbounds i32, ptr [[OUT]], i64 [[I]]
; DISABLED-NEXT:    store i32 [[IV]], ptr [[OP]], align 4
; DISABLED-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; DISABLED-NEXT:    [[CMP:%.*]] = icmp slt i64 [[I_NEXT]], [[N]]
; DISABLED-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; DISABLED:       [[EXIT]]:
; DISABLED-NEXT:    ret void
;
entry:
  %pk = getelementptr inbounds i32, ptr %a, i64 %k
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %xp = getelementptr inbounds i32, ptr %x, i64 %i
  %xv = load i32, ptr %xp, align 4
  %kv = load i32, ptr %pk, align 4
  %ksum = add i32 %kv, %xv
  store i32 %ksum, ptr %pk, align 4
  %yp = getelementptr inbounds i32, ptr %y, i64 %i
  %yv = load i32, ptr %yp, align 4
  %pi = getelementptr inbounds i32, ptr %a, i64 %i
  %iv = load i32, ptr %pi, align 4
  %isum = add i32 %iv, %yv
  store i32 %isum, ptr %pi, align 4
  %op = getelementptr inbounds i32, ptr %out, i64 %i
  store i32 %iv, ptr %op, align 4
  %i.next = add nuw nsw i64 %i, 1
  %cmp = icmp slt i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}
